generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum PerfilUsuario {
  formador_geral
  administrador
  formador_comunitario
  super_admin
}

enum PlanoAssinatura {
  GRATUITO
  ESSENCIAL
  PROFISSIONAL
}

enum StatusOrganizacao {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
}

// ==========================================================
// ORGANIZACAO — raiz do tenant
// ==========================================================

model Organizacao {
  id                   String            @id @default(cuid())
  nome                 String
  descricao            String?
  endereco             String?
  missao               String?
  anoFundacao          String?
  termoMorada               String            @default("Morada")
  termoFormando             String            @default("Formando")
  termoFormador             String            @default("Formador Comunitário")
  termoPreDiscipulado       String            @default("Pré-Discipulado")
  termoDiscipulado          String            @default("Discipulado")
  termoPrimeirasPromessas   String            @default("Primeiras Promessas")
  termoFormacaoPermanente   String            @default("Formação Permanente")
  planoAssinatura      PlanoAssinatura   @default(GRATUITO)
  status               StatusOrganizacao @default(TRIAL)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialExpiresAt       DateTime?
  cortesia             Boolean           @default(false)
  cortesiaExpiresAt    DateTime?
  cortesiaMotivo       String?
  nomePlataforma       String?
  logoUrl              String?           @db.Text
  temaCor              String            @default("azul")
  privacyVersion       String            @default("1.0")
  onboardingConcluido  Boolean           @default(false)
  criadoEm             DateTime          @default(now())
  atualizadoEm         DateTime          @updatedAt

  usuarios             Usuario[]
  moradas              Morada[]
  formandos            Formando[]
  planosFormativos     PlanoFormativo[]
  gradesFormativas     GradeFormativa[]
  formacoes            Formacao[]
  agendamentos         Agendamento[]
  presencas            PresencaFormacao[]
  comentarios          ComentarioFormando[]
  eventos              EventoFormando[]
  compromissos         Compromisso[]
  auditLogs            AuditLog[]
  arquivos             Arquivo[]
  convites             ConviteUsuario[]
  configuracao         ConfiguracaoOrg?

  @@index([status])
  @@index([planoAssinatura])
}

// ==========================================================
// CONFIGURACAO ORG — SMTP e template de e-mail por tenant
// ==========================================================

model ConfiguracaoOrg {
  id            String   @id @default(cuid())
  organizacaoId String   @unique
  smtpConfig    Json?
  emailTemplate Json?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
}

// ==========================================================
// USUARIO
// ==========================================================

model Usuario {
  id             String        @id @default(cuid())
  organizacaoId  String
  nome           String
  email          String
  passwordHash   String?
  perfil         PerfilUsuario
  moradaId       String?
  ativo          Boolean       @default(true)
  primeiroAcesso Boolean       @default(false)
  deletedAt      DateTime?
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt

  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  // Morada à qual este usuário está vinculado (formador_comunitario)
  morada         Morada?       @relation("UsuarioMorada", fields: [moradaId], references: [id])
  // Moradas das quais este usuário é formador responsável
  moradasFormadas Morada[]     @relation("MoradaFormador")
  auditLogs      AuditLog[]
  comentarios    ComentarioFormando[]
  eventos        EventoFormando[]
  compromissos   Compromisso[]
  formacoesCriadas   Formacao[]
  agendamentos       Agendamento[]
  privacyAcceptances PrivacyAcceptance[]
  convitesEnviados   ConviteUsuario[]

  @@unique([email, organizacaoId])
  @@index([organizacaoId])
  @@index([email])
}

// ==========================================================
// MORADA
// ==========================================================

model Morada {
  id             String    @id @default(cuid())
  organizacaoId  String
  nome           String
  localReuniao   String?
  // NivelFormativo como String para manter compatibilidade com tipos existentes
  // valores: "pre-discipulado" | "discipulado" | "primeiras-promessas" | "formacao-permanente"
  nivelFormativo String
  formadorId     String?
  planoId        String?
  gradeId        String?
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  ativo          Boolean   @default(true)
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  organizacao    Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formador       Usuario?       @relation("MoradaFormador", fields: [formadorId], references: [id])
  plano          PlanoFormativo? @relation(fields: [planoId], references: [id])
  grade          GradeFormativa? @relation(fields: [gradeId], references: [id])
  formandos      Formando[]
  // Usuários vinculados a esta morada (formadores_comunitarios)
  usuarios       Usuario[]      @relation("UsuarioMorada")

  @@index([organizacaoId])
  @@index([formadorId])
}

// ==========================================================
// FORMANDO
// ==========================================================

model Formando {
  id                  String    @id @default(cuid())
  organizacaoId       String
  nome                String
  dataNascimento      DateTime
  estadoCivil         String    // solteiro | casado | divorciado | viuvo
  modalidade          String    // presencial | online | hibrida
  nivelFormativo      String    // NivelFormativo
  dataIngresso        DateTime
  telefone            String
  email               String
  ativo               Boolean   @default(true)
  motivoInatividade   String?
  foto                String?
  turmaId             String?
  moradaId            String?
  totalFormacoes      Int       @default(0)
  formacoesRealizadas Int       @default(0)
  deletedAt           DateTime?
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  organizacao         Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  morada              Morada?         @relation(fields: [moradaId], references: [id])
  progressoEtapas     ProgressoEtapa[]
  presencas           PresencaFormacao[]
  comentarios         ComentarioFormando[]
  eventos             EventoFormando[]
  compromissos        Compromisso[]

  @@index([organizacaoId])
  @@index([moradaId])
  @@index([organizacaoId, ativo])
  @@index([deletedAt])
}

// ==========================================================
// PROGRESSO ETAPA (1:N de Formando)
// ==========================================================

model ProgressoEtapa {
  id                              String   @id @default(cuid())
  formandoId                      String
  nivelFormativo                  String   // NivelFormativo
  formacoesComunitariasRealizadas Int      @default(0)
  retirosComunitariosRealizados   Int      @default(0)
  retirosPessoaisRealizados       Int      @default(0)
  iniciouEm                       DateTime?
  concluiuEm                      DateTime?

  formando                        Formando @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@unique([formandoId, nivelFormativo])
  @@index([formandoId])
}

// ==========================================================
// PLANO FORMATIVO
// organizacaoId null = conteúdo global (isGlobal = true)
// ==========================================================

model PlanoFormativo {
  id               String    @id @default(cuid())
  organizacaoId    String?
  isGlobal         Boolean   @default(false)
  nome             String
  objetivos        String
  fundamentacao    String
  nivelFormativo   String    // NivelFormativo
  vigenciaInicio   DateTime
  vigenciaFim      DateTime
  status           String    @default("rascunho") // StatusPlano
  documentoAnexo   String?
  documentoAnexoId String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  organizacao      Organizacao?    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  eixos            EixoPlano[]
  gradesFormativas GradeFormativa[]
  moradas          Morada[]

  @@index([organizacaoId])
}

// ==========================================================
// EIXO PLANO (1:N de PlanoFormativo)
// ==========================================================

model EixoPlano {
  id                 String @id @default(cuid())
  planoId            String
  nome               String
  objetivo           String
  intervaloEncontros String
  cargaHoraria       Int
  areaFormacao       String

  plano              PlanoFormativo @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@index([planoId])
}

// ==========================================================
// GRADE FORMATIVA
// organizacaoId null = conteúdo global
// ==========================================================

model GradeFormativa {
  id               String    @id @default(cuid())
  organizacaoId    String?
  isGlobal         Boolean   @default(false)
  nome             String    @default("")
  planoId          String
  planoNome        String
  nivelFormativo   String    // NivelFormativo
  vigenciaInicio   DateTime
  vigenciaFim      DateTime
  versao           String    @default("1.0")
  totalFormacoes   Int       @default(0)
  objetivos        String?
  fundamentacao    String?
  documentoAnexo   String?
  documentoAnexoId String?
  ativo            Boolean   @default(true)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  organizacao      Organizacao?   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  plano            PlanoFormativo @relation(fields: [planoId], references: [id])
  eixos            Eixo[]
  moradas          Morada[]

  @@index([organizacaoId])
}

// ==========================================================
// EIXO (1:N de GradeFormativa)
// ==========================================================

model Eixo {
  id        String @id @default(cuid())
  gradeId   String
  nome      String
  descricao String
  ordem     Int    @default(0)
  cor       String?

  grade     GradeFormativa @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  etapas    Etapa[]

  @@index([gradeId])
}

// ==========================================================
// ETAPA (1:N de Eixo)
// ==========================================================

model Etapa {
  id           String @id @default(cuid())
  eixoId       String
  nome         String
  descricao    String
  ordem        Int    @default(0)
  cargaHoraria Int

  eixo         Eixo   @relation(fields: [eixoId], references: [id], onDelete: Cascade)

  @@index([eixoId])
}

// ==========================================================
// FORMACAO
// organizacaoId null = conteúdo global
// ==========================================================

model Formacao {
  id               String    @id @default(cuid())
  organizacaoId    String?
  isGlobal         Boolean   @default(false)
  tema             String
  objetivo         String
  descricao        String
  nivelFormativo   String    // NivelFormativo
  tipoFormacao     String    // TipoFormacao
  eixoId           String?
  eixoNome         String?
  etapaId          String?
  etapaNome        String?
  formadorId       String?
  formadorNome     String
  cargaHoraria     Int
  modalidade       String    // Modalidade
  materialApoio    String?
  documentoAnexo   String?
  documentoAnexoId String?
  gradeId          String?
  gradeNome        String?
  vezesUtilizada   Int       @default(0)
  deletedAt        DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  organizacao      Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formador         Usuario?     @relation(fields: [formadorId], references: [id])
  agendamentos     Agendamento[]

  @@index([organizacaoId])
  @@index([deletedAt])
}

// ==========================================================
// AGENDAMENTO
// ==========================================================

model Agendamento {
  id                    String    @id @default(cuid())
  organizacaoId         String
  formacaoId            String
  formacaoTema          String
  nivelFormativo        String    // NivelFormativo
  tipoFormacao          String    // TipoFormacao
  formadorId            String
  formadorNome          String
  dataInicio            DateTime
  dataFim               DateTime
  local                 String?
  linkOnline            String?
  status                String    @default("agendada") // StatusFormacao
  participantes         Int       @default(0)
  observacoes           String?
  googleCalendarEventId String?
  deletedAt             DateTime?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  organizacao           Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formacao              Formacao     @relation(fields: [formacaoId], references: [id])
  formador              Usuario      @relation(fields: [formadorId], references: [id])
  presencas             PresencaFormacao[]

  @@index([organizacaoId])
  @@index([dataInicio])
  @@index([status])
  @@index([organizacaoId, status, dataInicio])
  @@index([deletedAt])
}

// ==========================================================
// PRESENCA FORMACAO
// ==========================================================

model PresencaFormacao {
  id             String   @id @default(cuid())
  organizacaoId  String
  agendamentoId  String
  formacaoTema   String
  data           DateTime
  formandoId     String
  formandoNome   String
  nivelFormativo String   // NivelFormativo
  presente       Boolean  @default(false)
  justificativa  String?
  criadoEm      DateTime @default(now())

  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  agendamento    Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  formando       Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@unique([agendamentoId, formandoId])
  @@index([organizacaoId])
  @@index([formandoId])
}

// ==========================================================
// COMENTARIO FORMANDO
// ==========================================================

model ComentarioFormando {
  id            String   @id @default(cuid())
  organizacaoId String
  formandoId    String
  formandoNome  String
  formadorId    String
  formadorNome  String?
  texto         String
  tipo          String   // TipoComentario
  criadoEm     DateTime @default(now())

  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando      Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  formador      Usuario     @relation(fields: [formadorId], references: [id])

  @@index([organizacaoId])
  @@index([formandoId])
}

// ==========================================================
// EVENTO FORMANDO
// ==========================================================

model EventoFormando {
  id                            String    @id @default(cuid())
  organizacaoId                 String
  formandoId                    String
  formadorId                    String
  tipo                          String    // TipoEventoFormando
  periodoInicio                 DateTime?
  periodoFim                    DateTime?
  notaAdesao                    String?   // NotaAdesao
  textoAvaliacao                String?
  motivo                        String?
  tipoDesligamento              String?   // TipoDesligamento
  dataEfetiva                   DateTime?
  checklistDevolveuEstatuto     Boolean?
  checklistDevolveuSacramental  Boolean?
  checklistApresentouCarta      Boolean?
  checklistAcompanhadoModerador Boolean?
  dataInicioLicenca             DateTime?
  dataFimLicenca                DateTime?
  criadoEm                     DateTime  @default(now())

  organizacao                   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando                      Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  formador                      Usuario     @relation(fields: [formadorId], references: [id])
  documentos                    Arquivo[]

  @@index([organizacaoId])
  @@index([formandoId])
}

// ==========================================================
// COMPROMISSO
// ==========================================================

model Compromisso {
  id                    String   @id @default(cuid())
  organizacaoId         String
  formadorId            String
  titulo                String
  descricao             String?
  dataInicio            DateTime
  dataFim               DateTime
  local                 String?
  linkOnline            String?
  tipo                  String   // TipoCompromisso
  formandoId            String?
  formandoNome          String?
  googleCalendarEventId String?
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  organizacao           Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formador              Usuario     @relation(fields: [formadorId], references: [id])
  formando              Formando?   @relation(fields: [formandoId], references: [id])

  @@index([organizacaoId])
  @@index([formadorId])
}

// ==========================================================
// ARQUIVO — storage unificado (docs de eventos + uploads avulsos)
// storageKey: path relativo no disco local (dev) ou key no R2 (prod)
// Ativação R2: definir R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
// ==========================================================

model Arquivo {
  id              String   @id @default(cuid())
  organizacaoId   String
  nome            String
  tamanho         Int
  tipo            String   // MIME type
  extensao        String   @default(".pdf") // .pdf | .docx | .doc
  storageKey      String   // path relativo no disco ou key no R2
  uploadedById    String?
  uploadedByNome  String?
  // Associação genérica: plano | grade | formacao
  entityType      String?
  entityId        String?
  // Associação com evento de formando
  eventoId        String?
  formandoId      String?
  formandoNome    String?
  tipoEvento      String?
  moradaId        String?
  criadoEm       DateTime @default(now())

  organizacao     Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  evento          EventoFormando? @relation(fields: [eventoId], references: [id], onDelete: SetNull)

  @@index([organizacaoId])
  @@index([eventoId])
  @@index([entityType, entityId])
  @@index([uploadedById])
}

// ==========================================================
// CONVITE DE USUARIO (Fase 3 — D3.4)
// ==========================================================

model ConviteUsuario {
  id            String        @id @default(cuid())
  organizacaoId String
  email         String
  nome          String
  perfil        PerfilUsuario
  moradaId      String?
  token         String        @unique @default(cuid())
  expiresAt     DateTime
  aceitoEm      DateTime?
  criadoPorId   String
  criadoEm      DateTime      @default(now())

  organizacao   Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  criadoPor     Usuario       @relation(fields: [criadoPorId], references: [id])

  @@index([organizacaoId])
  @@index([token])
  @@index([email])
  @@index([expiresAt])
}

// ==========================================================
// LGPD — tabelas de compliance (D2.1 / Fase 5)
// ==========================================================

model PrivacyAcceptance {
  id            String   @id @default(cuid())
  usuarioId     String
  organizacaoId String?
  tipo          String   // "privacidade" | "termos"
  versao        String
  ip            String?  // IP anonimizado no momento do aceite (art. 7º Marco Civil)
  criadoEm     DateTime @default(now())

  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tipo])
}

model CookieConsent {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String?
  organizacaoId String?
  necessarios   Boolean  @default(true)
  analiticos    Boolean  @default(false)
  marketing     Boolean  @default(false)
  preferencias  Boolean  @default(false)
  versao        String   @default("1")
  ip            String?  // IP anonimizado no momento do consentimento (5 anos — LGPD)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([userId])
}

model DeletionRequest {
  id            String    @id @default(cuid())
  usuarioId     String?
  organizacaoId String?
  tipo          String    // "usuario" | "organizacao"
  status        String    @default("pendente") // pendente | processando | concluido
  solicitadoEm DateTime  @default(now())
  processadoEm DateTime?

  @@index([usuarioId])
  @@index([organizacaoId])
  @@index([status])
}

// ==========================================================
// AUDIT LOG
// ==========================================================

model AuditLog {
  id            String   @id @default(cuid())
  organizacaoId String?
  usuarioId     String?
  acao          String
  ip            String?
  detalhes      Json?
  criadoEm     DateTime @default(now())

  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([organizacaoId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
}
