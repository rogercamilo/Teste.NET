generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum PerfilUsuario {
  formador_geral
  administrador
  formador_comunitario
  super_admin
}

// GRATUITO = sem assinatura ativa (estado interno, não comercializado)
// BASICO="Básico" R$97 | INTERMEDIARIO="Intermediário" R$197 | AVANCADO="Avançado" R$397 | PERSONALIZADO="Personalizado" R$890+
enum PlanoAssinatura {
  GRATUITO
  BASICO
  INTERMEDIARIO
  AVANCADO
  PERSONALIZADO
}

enum StatusOrganizacao {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
}

enum TipoOrganizacao {
  nova_comunidade
  grupo_oracao
  instituto_religioso
  centro_formativo
}

enum TipoGrupoFormacao {
  estruturado
  livre
  vocacional
}

enum TipoProcessoEclesiastico {
  admissao_etapa1
  admissao_etapa2
  promessas_iniciais
  renovacao_promessas
  promessas_definitivas
  ministerio
  missao
  licenca
  transferencia
  desligamento
  falecimento
}

enum StatusProcessoEclesiastico {
  rascunho
  em_andamento
  em_revisao
  aprovado
  rejeitado
  concluido
  arquivado
  cancelado
}

enum TipoDocumentoEclesiastico {
  ato_admissao
  informacoes_pastorais
  declaracao_responsavel
  ciencia_politicas_internas
  termo_cerimonial
  termo_consagracao
  requerimento_renovacao
  parecer_formativo
  ato_admissao_renovacao
  termo_renovacao
  carta_missao
  carta_transferencia
  carta_licenca
  termo_desligamento
  dispensa_promessas
}

enum StatusDocumentoEclesiastico {
  pendente
  gerado
  assinado
  arquivado
  substituido
}

enum TipoRegistroPromessa {
  iniciais_temporarias
  renovacao
  definitivas
  dispensa
}

// ── Livro de Registro Geral da Jornada Vocacional ──────────────────────────
enum StatusTomo {
  aberto
  encerrado
}

enum CondicaoMembro {
  candidato
  membro_em_experiencia
  membro_em_formacao
  membro_primeiras_promessas
  membro_consagrado
  membro_definitivas
  desligado
  falecido
}

enum TipoTermoRegistro {
  admissao_etapa
  conclusao_etapa
  primeiras_promessas
  renovacao_promessas
  promessas_definitivas
  ministerio
  missao
  transferencia
  licenca_inicio
  licenca_termino
  desligamento
  dispensa
  falecimento
  retificacao
  ingresso_vocacional
  termino_vocacional
}

// ── Período Vocacional ─────────────────────────────────────────────────────
enum StatusParticipacaoVocacional {
  ativa
  aguardando_carta
  em_discernimento
  concluida_deferida
  recusada_arquivada
  indeferida_arquivada
  cancelada
}

enum DesfechoCartaVocacional {
  pedido
  recusa
}

enum TipoEncontroAcompanhamento {
  mensal
  extra
}

enum StatusSolicitacaoAcompanhamento {
  pendente
  agendada
  recusada
}

enum TipoNotificacao {
  nova_formacao
  novo_formando
  novo_agendamento
  processo_aprovado
  plano_atribuido
  plano_atualizado
  grade_atribuida
  grade_atualizada
  dados_formando_pendentes
  justificativa_formando
}

// ==========================================================
// ORGANIZACAO — raiz do tenant
// ==========================================================

model Organizacao {
  id                            String            @id @default(cuid())
  tipoOrganizacao               TipoOrganizacao   @default(nova_comunidade)
  nome                          String
  descricao                     String?
  endereco                      String?
  missao                        String?
  anoFundacao                   String?
  termoGrupoFormacao            String            @default("Grupo de Formação") @map("termo_morada")
  termoFormando                 String            @default("Formando")
  termoFormador                 String            @default("Formador Comunitário")
  termoPreDiscipulado           String            @default("Pré-Discipulado")
  termoDiscipulado              String            @default("Discipulado")
  termoPrimeirasPromessas       String            @default("Primeiras Promessas")
  termoFormacaoPermanente       String            @default("Formação Permanente")
  termoPromessa                 String            @default("Promessa")
  // Período Vocacional (módulo opcional, desacoplado do tipoOrganizacao)
  vocacionalHabilitado          Boolean           @default(false)
  termoVocacional               String            @default("Período Vocacional")
  termoAcompanhamentoVocacional String            @default("Acompanhamento Vocacional")
  vocacionalDuracaoPadraoMeses  Int               @default(12)
  planoAssinatura               PlanoAssinatura   @default(GRATUITO)
  status                        StatusOrganizacao @default(TRIAL)
  stripeCustomerId              String?
  stripeSubscriptionId          String?
  trialExpiresAt                DateTime?
  canceladoEm                   DateTime?
  cortesia                      Boolean           @default(false)
  cortesiaExpiresAt             DateTime?
  cortesiaMotivo                String?
  nomePlataforma                String?
  logoUrl                       String?           @db.Text
  temaCor                       String            @default("formatio")
  privacyVersion                String            @default("1.0")
  onboardingConcluido           Boolean           @default(false)
  criadoEm                      DateTime          @default(now())
  atualizadoEm                  DateTime          @updatedAt

  usuarios                  Usuario[]
  gruposFormacao            GrupoFormacao[]
  formandos                 Formando[]
  planosFormativos          PlanoFormativo[]
  gradesFormativas          GradeFormativa[]
  formacoes                 Formacao[]
  agendamentos              Agendamento[]
  presencas                 PresencaFormacao[]
  comentarios               ComentarioFormando[]
  eventos                   EventoFormando[]
  compromissos              Compromisso[]
  auditLogs                 AuditLog[]
  arquivos                  Arquivo[]
  convites                  ConviteUsuario[]
  configuracao              ConfiguracaoOrg?
  pushSubscriptions         PushSubscription[]
  relatorios                RelatorioEtapa[]
  processosEclesiasticos    ProcessoEclesiastico[]
  registrosPromessa         RegistroPromessa[]
  notificacoes              Notificacao[]
  livrosRegistroTomo        LivroRegistroTomo[]
  termosRegistro            TermoRegistro[]
  participacoesVocacional   ParticipacaoVocacional[]
  acompanhamentosVocacional AcompanhamentoVocacional[]

  @@index([status])
  @@index([planoAssinatura])
}

// ==========================================================
// CONFIGURACAO ORG — SMTP e template de e-mail por tenant
// ==========================================================

model ConfiguracaoOrg {
  id            String   @id @default(cuid())
  organizacaoId String   @unique
  smtpConfig    Json?
  emailTemplate Json?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
}

// ==========================================================
// USUARIO
// ==========================================================

model Usuario {
  id                 String        @id @default(cuid())
  organizacaoId      String
  nome               String
  email              String
  passwordHash       String?
  perfil             PerfilUsuario
  grupoFormacaoId    String?       @map("morada_id")
  ativo              Boolean       @default(true)
  primeiroAcesso     Boolean       @default(false)
  mfaSecret          String?       @db.Text
  mfaEnabled         Boolean       @default(false)
  mfaSecretExpiresAt DateTime?
  loginFailures      Int           @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  deletedAt          DateTime?
  criadoEm           DateTime      @default(now())
  atualizadoEm       DateTime      @updatedAt

  organizacao                    Organizacao                @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  // GrupoFormacao ao qual este usuário está vinculado (formador_comunitario)
  grupoFormacao                  GrupoFormacao?             @relation("UsuarioGrupoFormacao", fields: [grupoFormacaoId], references: [id])
  // GruposFormacao dos quais este usuário é formador responsável
  gruposFormados                 GrupoFormacao[]            @relation("GrupoFormacaoFormador")
  auditLogs                      AuditLog[]
  comentarios                    ComentarioFormando[]
  eventos                        EventoFormando[]
  compromissos                   Compromisso[]
  formacoesCriadas               Formacao[]
  agendamentos                   Agendamento[]
  privacyAcceptances             PrivacyAcceptance[]
  convitesEnviados               ConviteUsuario[]
  relatoriosRedigidos            RelatorioEtapa[]
  processosEclesiasticosCriados  ProcessoEclesiastico[]     @relation("ProcessoCriador")
  documentosEclesiasticosGerados DocumentoEclesiastico[]    @relation("DocumentoGerador")
  passwordResetTokens            PasswordResetToken[]
  notificacoes                   Notificacao[]
  pushSubscriptions              PushSubscription[]
  participacoesAcompanhadas      ParticipacaoVocacional[]   @relation("AcompanhadorParticipacao")
  acompanhamentosRegistrados     AcompanhamentoVocacional[] @relation("AcompanhadorRegistro")

  @@unique([email, organizacaoId])
  @@index([organizacaoId])
  @@index([email])
}

// ==========================================================
// PASSWORD RESET TOKEN
// ==========================================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==========================================================
// GRUPO FORMACAO
// ==========================================================

model GrupoFormacao {
  id                            String            @id @default(cuid())
  organizacaoId                 String
  nome                          String
  localReuniao                  String?
  // NivelFormativo: obrigatório para grupos estruturados, null para grupos livres
  nivelFormativo                String?
  tipo                          TipoGrupoFormacao @default(estruturado)
  formadorId                    String?
  planoId                       String?
  gradeId                       String?
  vigenciaInicio                DateTime?
  vigenciaFim                   DateTime?
  imagemUrl                     String?           @db.Text
  ativo                         Boolean           @default(true)
  // Campos usados apenas quando tipo = vocacional (turma do Período Vocacional)
  vocacionalAcompanhamentoAtivo Boolean           @default(false)
  vocacionalTotalRetiros        Int?
  vocacionalDuracaoMeses        Int?
  criadoEm                      DateTime          @default(now())
  atualizadoEm                  DateTime          @updatedAt

  organizacao             Organizacao              @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formador                Usuario?                 @relation("GrupoFormacaoFormador", fields: [formadorId], references: [id])
  plano                   PlanoFormativo?          @relation(fields: [planoId], references: [id])
  grade                   GradeFormativa?          @relation(fields: [gradeId], references: [id])
  formandos               Formando[]
  agendamentos            Agendamento[]
  participacoesVocacional ParticipacaoVocacional[]
  // Usuários vinculados a este grupo de formação (formadores_comunitarios)
  usuarios                Usuario[]                @relation("UsuarioGrupoFormacao")

  @@index([organizacaoId])
  @@index([formadorId])
  @@map("morada")
}

// ==========================================================
// FORMANDO
// ==========================================================

model Formando {
  id                  String          @id @default(cuid())
  organizacaoId       String
  nome                String
  dataNascimento      DateTime
  estadoCivil         String // solteiro | casado | divorciado | viuvo
  modalidade          String // presencial | online | hibrida
  nivelFormativo      String // NivelFormativo
  dataIngresso        DateTime
  telefone            String
  email               String
  ativo               Boolean         @default(true)
  motivoInatividade   String?
  foto                String?
  nomeSocial          String?
  nacionalidade       String?
  rg                  String?
  orgaoEmissor        String?
  cep                 String?
  paroquiaReferencia  String?
  numFilhos           Int?
  condicaoAtual       CondicaoMembro?
  turmaId             String?
  grupoFormacaoId     String?         @map("morada_id")
  tokenAssinatura     String?         @unique
  totalFormacoes      Int             @default(0)
  formacoesRealizadas Int             @default(0)
  deletedAt           DateTime?
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt

  organizacao             Organizacao              @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  grupoFormacao           GrupoFormacao?           @relation(fields: [grupoFormacaoId], references: [id])
  progressoEtapas         ProgressoEtapa[]
  presencas               PresencaFormacao[]
  comentarios             ComentarioFormando[]
  eventos                 EventoFormando[]
  compromissos            Compromisso[]
  relatorios              RelatorioEtapa[]
  processosEclesiasticos  ProcessoEclesiastico[]
  registrosPromessa       RegistroPromessa[]
  pushSubscriptions       PushSubscription[]
  termosRegistro          TermoRegistro[]
  participacoesVocacional ParticipacaoVocacional[]

  @@index([organizacaoId])
  @@index([grupoFormacaoId])
  @@index([organizacaoId, ativo])
  @@index([deletedAt])
}

// ==========================================================
// PROGRESSO ETAPA (1:N de Formando)
// ==========================================================

model ProgressoEtapa {
  id                              String    @id @default(cuid())
  formandoId                      String
  nivelFormativo                  String // NivelFormativo
  formacoesComunitariasRealizadas Int       @default(0)
  retirosComunitariosRealizados   Int       @default(0)
  retirosPessoaisRealizados       Int       @default(0)
  iniciouEm                       DateTime?
  concluiuEm                      DateTime?
  dataMissaCompromisso            DateTime?

  formando Formando @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@unique([formandoId, nivelFormativo])
}

// ==========================================================
// PLANO FORMATIVO
// organizacaoId null = conteúdo global (isGlobal = true)
// ==========================================================

model PlanoFormativo {
  id               String   @id @default(cuid())
  organizacaoId    String?
  isGlobal         Boolean  @default(false)
  nome             String
  objetivos        String
  fundamentacao    String
  nivelFormativo   String // NivelFormativo
  vigenciaInicio   DateTime
  vigenciaFim      DateTime
  status           String   @default("rascunho") // StatusPlano
  documentoAnexo   String?
  documentoAnexoId String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  organizacao      Organizacao?     @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  eixos            EixoPlano[]
  gradesFormativas GradeFormativa[]
  gruposFormacao   GrupoFormacao[]
  retiros          RetiroPlano[]

  @@index([organizacaoId])
}

// ==========================================================
// RETIRO PLANO (1:N de PlanoFormativo)
// tipo: "comunitario" | "pessoal"
// ==========================================================

model RetiroPlano {
  id             String  @id @default(cuid())
  planoId        String
  tipo           String
  numero         Int
  tema           String
  trechoBiblico  String?
  objetivo       String
  quandoRealizar String
  cargaHoraria   Int     @default(0)

  plano PlanoFormativo @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@index([planoId])
}

// ==========================================================
// EIXO PLANO (1:N de PlanoFormativo)
// ==========================================================

model EixoPlano {
  id                 String  @id @default(cuid())
  planoId            String
  nome               String
  nomeEtapa          String?
  objetivo           String
  intervaloEncontros String
  cargaHoraria       Int
  areaFormacao       String
  ordem              Int     @default(0)

  plano      PlanoFormativo @relation(fields: [planoId], references: [id], onDelete: Cascade)
  eixosGrade Eixo[]

  @@index([planoId])
}

// ==========================================================
// GRADE FORMATIVA
// organizacaoId null = conteúdo global
// ==========================================================

model GradeFormativa {
  id               String   @id @default(cuid())
  organizacaoId    String?
  isGlobal         Boolean  @default(false)
  nome             String   @default("")
  planoId          String
  planoNome        String
  nivelFormativo   String // NivelFormativo
  vigenciaInicio   DateTime
  vigenciaFim      DateTime
  versao           String   @default("1.0")
  totalFormacoes   Int      @default(0)
  objetivos        String?
  fundamentacao    String?
  documentoAnexo   String?
  documentoAnexoId String?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  organizacao    Organizacao?    @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  plano          PlanoFormativo  @relation(fields: [planoId], references: [id])
  eixos          Eixo[]
  gruposFormacao GrupoFormacao[]

  @@index([organizacaoId])
  @@index([planoId])
}

// ==========================================================
// EIXO (1:N de GradeFormativa)
// ==========================================================

model Eixo {
  id          String  @id @default(cuid())
  gradeId     String
  nome        String
  descricao   String
  ordem       Int     @default(0)
  cor         String?
  eixoPlanoId String?

  grade     GradeFormativa @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  eixoPlano EixoPlano?     @relation(fields: [eixoPlanoId], references: [id], onDelete: SetNull)
  etapas    Etapa[]

  @@index([gradeId])
  @@index([eixoPlanoId])
}

// ==========================================================
// ETAPA (1:N de Eixo)
// ==========================================================

model Etapa {
  id           String @id @default(cuid())
  eixoId       String
  nome         String
  descricao    String
  ordem        Int    @default(0)
  cargaHoraria Int

  eixo Eixo @relation(fields: [eixoId], references: [id], onDelete: Cascade)

  @@index([eixoId])
}

// ==========================================================
// FORMACAO
// organizacaoId null = conteúdo global
// ==========================================================

model Formacao {
  id                  String    @id @default(cuid())
  organizacaoId       String?
  isGlobal            Boolean   @default(false)
  tema                String
  objetivo            String
  descricao           String
  nivelFormativo      String // NivelFormativo
  tipoFormacao        String // TipoFormacao
  eixoId              String?
  eixoNome            String?
  etapaId             String?
  etapaNome           String?
  formadorId          String?
  formadorNome        String
  cargaHoraria        Int
  modalidade          String // Modalidade
  materialApoio       String?
  documentoAnexo      String?
  documentoAnexoId    String?
  gradeId             String?
  gradeNome           String?
  numero              Int?
  observacoesFormador String?
  vezesUtilizada      Int       @default(0)
  deletedAt           DateTime?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  organizacao  Organizacao?  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formador     Usuario?      @relation(fields: [formadorId], references: [id])
  agendamentos Agendamento[]

  @@index([organizacaoId])
  @@index([deletedAt])
}

// ==========================================================
// AGENDAMENTO
// ==========================================================

model Agendamento {
  id                    String    @id @default(cuid())
  organizacaoId         String
  formacaoId            String
  formacaoTema          String
  nivelFormativo        String // NivelFormativo
  tipoFormacao          String // TipoFormacao
  formadorId            String
  formadorNome          String
  grupoFormacaoId       String?   @map("morada_id")
  dataInicio            DateTime
  dataFim               DateTime
  local                 String?
  linkOnline            String?
  status                String    @default("agendada") // StatusFormacao
  participantes         Int       @default(0)
  observacoes           String?
  googleCalendarEventId String?
  deletedAt             DateTime?
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  organizacao   Organizacao        @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formacao      Formacao           @relation(fields: [formacaoId], references: [id])
  formador      Usuario            @relation(fields: [formadorId], references: [id])
  grupoFormacao GrupoFormacao?     @relation(fields: [grupoFormacaoId], references: [id], onDelete: SetNull)
  presencas     PresencaFormacao[]

  @@index([organizacaoId])
  @@index([dataInicio])
  @@index([status])
  @@index([grupoFormacaoId])
  @@index([organizacaoId, status, dataInicio])
  @@index([deletedAt])
}

// ==========================================================
// PRESENCA FORMACAO
// ==========================================================

model PresencaFormacao {
  id                    String   @id @default(cuid())
  organizacaoId         String
  agendamentoId         String
  formacaoTema          String
  data                  DateTime
  formandoId            String
  formandoNome          String
  nivelFormativo        String // NivelFormativo
  presente              Boolean  @default(false)
  justificativa         String?
  // Campos do Portal do Formando — fonte de verdade continua sendo o formador
  confirmacaoFormando   Boolean? // null=sem resposta, true=confirmou presença, false=avisou ausência
  justificativaFormando String? // texto enviado pelo próprio formando
  criadoEm              DateTime @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  formando    Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)

  @@unique([agendamentoId, formandoId])
  @@index([organizacaoId, formandoId])
  @@index([formandoId])
}

// ==========================================================
// COMENTARIO FORMANDO
// ==========================================================

model ComentarioFormando {
  id            String   @id @default(cuid())
  organizacaoId String
  formandoId    String
  formandoNome  String
  formadorId    String
  formadorNome  String?
  texto         String
  tipo          String // TipoComentario
  criadoEm      DateTime @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando    Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  formador    Usuario     @relation(fields: [formadorId], references: [id])

  @@index([organizacaoId, formandoId])
  @@index([formandoId])
}

// ==========================================================
// EVENTO FORMANDO
// ==========================================================

model EventoFormando {
  id                            String    @id @default(cuid())
  organizacaoId                 String
  formandoId                    String
  formadorId                    String
  tipo                          String // TipoEventoFormando
  periodoInicio                 DateTime?
  periodoFim                    DateTime?
  notaAdesao                    String? // NotaAdesao
  perspectiva                   String? // PerspectivFormativa: humana | espiritual | comunitaria
  textoAvaliacao                String?
  motivo                        String?
  tipoDesligamento              String? // TipoDesligamento
  dataEfetiva                   DateTime?
  checklistDevolveuEstatuto     Boolean?
  checklistDevolveuSacramental  Boolean?
  checklistApresentouCarta      Boolean?
  checklistAcompanhadoModerador Boolean?
  dataInicioLicenca             DateTime?
  dataFimLicenca                DateTime?
  criadoEm                      DateTime  @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando    Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  formador    Usuario     @relation(fields: [formadorId], references: [id])
  documentos  Arquivo[]

  @@index([organizacaoId, formandoId])
  @@index([formandoId])
}

// ==========================================================
// COMPROMISSO
// ==========================================================

model Compromisso {
  id                    String   @id @default(cuid())
  organizacaoId         String
  formadorId            String
  titulo                String
  descricao             String?
  dataInicio            DateTime
  dataFim               DateTime
  local                 String?
  linkOnline            String?
  tipo                  String // TipoCompromisso
  formandoId            String?
  formandoNome          String?
  googleCalendarEventId String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formador    Usuario     @relation(fields: [formadorId], references: [id])
  formando    Formando?   @relation(fields: [formandoId], references: [id])

  @@index([organizacaoId])
  @@index([formadorId])
}

// ==========================================================
// ARQUIVO — storage unificado (docs de eventos + uploads avulsos)
// storageKey: path relativo no disco local (dev) ou key no R2 (prod)
// Ativação R2: definir R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
// ==========================================================

model Arquivo {
  id              String   @id @default(cuid())
  organizacaoId   String
  nome            String
  tamanho         Int
  tipo            String // MIME type
  extensao        String   @default(".pdf") // .pdf | .docx | .doc
  storageKey      String // path relativo no disco ou key no R2
  uploadedById    String?
  uploadedByNome  String?
  // Associação genérica: plano | grade | formacao
  entityType      String?
  entityId        String?
  // Associação com evento de formando
  eventoId        String?
  formandoId      String?
  formandoNome    String?
  tipoEvento      String?
  grupoFormacaoId String?  @map("morada_id")
  criadoEm        DateTime @default(now())

  organizacao             Organizacao             @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  evento                  EventoFormando?         @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  documentosEclesiasticos DocumentoEclesiastico[]
  registrosPromessa       RegistroPromessa[]

  @@index([organizacaoId])
  @@index([eventoId])
  @@index([entityType, entityId])
  @@index([uploadedById])
}

// ==========================================================
// CONVITE DE USUARIO (Fase 3 — D3.4)
// ==========================================================

model ConviteUsuario {
  id              String        @id @default(cuid())
  organizacaoId   String
  email           String
  nome            String
  perfil          PerfilUsuario
  grupoFormacaoId String?       @map("morada_id")
  token           String        @unique
  expiresAt       DateTime
  aceitoEm        DateTime?
  criadoPorId     String
  criadoEm        DateTime      @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  criadoPor   Usuario     @relation(fields: [criadoPorId], references: [id])

  @@index([organizacaoId])
  @@index([email])
  @@index([expiresAt])
}

// ==========================================================
// LGPD — tabelas de compliance (D2.1 / Fase 5)
// ==========================================================

model PrivacyAcceptance {
  id            String   @id @default(cuid())
  usuarioId     String
  organizacaoId String?
  tipo          String // "privacidade" | "termos"
  versao        String
  ip            String? // IP anonimizado no momento do aceite (art. 7º Marco Civil)
  criadoEm      DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tipo])
}

model CookieConsent {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String?
  organizacaoId String?
  necessarios   Boolean  @default(true)
  analiticos    Boolean  @default(false)
  marketing     Boolean  @default(false)
  preferencias  Boolean  @default(false)
  versao        String   @default("1")
  ip            String? // IP anonimizado no momento do consentimento (5 anos — LGPD)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@index([userId])
}

model DeletionRequest {
  id            String    @id @default(cuid())
  usuarioId     String?
  organizacaoId String?
  tipo          String // "usuario" | "organizacao"
  status        String    @default("pendente") // pendente | processando | concluido
  solicitadoEm  DateTime  @default(now())
  processadoEm  DateTime?

  @@index([usuarioId])
  @@index([organizacaoId])
  @@index([status])
}

// ==========================================================
// RELATORIO DE ETAPA — 1 por formando por nivelFormativo
// ==========================================================

model RelatorioEtapa {
  id                   String   @id @default(cuid())
  organizacaoId        String
  formandoId           String
  formadorId           String
  nivelFormativo       String // NivelFormativo
  avaliacaoHumana      String? // NotaAdesao
  avaliacaoEspiritual  String? // NotaAdesao
  avaliacaoComunitaria String? // NotaAdesao
  textoNarrativo       String?  @db.Text
  pontosForteza        String?  @db.Text
  desafios             String?  @db.Text
  recomendacao         String? // RecomendacaoEtapa
  textoRecomendacao    String?  @db.Text
  status               String   @default("rascunho") // StatusRelatorio
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando    Formando    @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  formador    Usuario     @relation(fields: [formadorId], references: [id])

  @@unique([formandoId, nivelFormativo])
  @@index([organizacaoId])
}

// ==========================================================
// STRIPE — idempotência de webhooks
// ==========================================================

model ProcessedWebhookEvent {
  id          String   @id // ID do evento (Stripe evt_xxx / Resend svix msg_xxx) — garante idempotência
  processedAt DateTime @default(now())
}

// ==========================================================
// EMAIL — lista de supressão (bounces permanentes e reclamações)
// ==========================================================

enum EmailSuppressionMotivo {
  BOUNCE // hard bounce: endereço inexistente/rejeitado permanentemente
  COMPLAINT // destinatário marcou como spam
}

/// Endereços que NÃO devem mais receber e-mails. Escopo global por endereço:
/// um hard bounce/reclamação vale para qualquer organização. organizacaoId e
/// emailId são apenas para auditoria/origem.
model EmailSuppression {
  id            String                 @id @default(cuid())
  email         String                 @unique // sempre normalizado em minúsculas
  motivo        EmailSuppressionMotivo
  detalhe       String?                @db.Text // mensagem do servidor receptor
  emailId       String? // Resend email_id que originou o evento
  organizacaoId String? // org de origem (auditoria)
  criadoEm      DateTime               @default(now())

  @@index([organizacaoId])
}

// ==========================================================
// PUSH SUBSCRIPTION — notificações Web Push por organização
// ==========================================================

model PushSubscription {
  id              String   @id @default(cuid())
  organizacaoId   String
  usuarioId       String?
  formandoId      String?
  grupoFormacaoId String?
  endpoint        String
  p256dh          String   @db.Text
  auth            String   @db.Text
  criadoEm        DateTime @default(now())

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  formando    Formando?   @relation(fields: [formandoId], references: [id], onDelete: SetNull)

  @@unique([organizacaoId, endpoint])
  @@index([usuarioId])
  @@index([formandoId])
  @@index([grupoFormacaoId])
}

// ==========================================================
// NOTIFICACAO — alertas internos para Formadores Comunitários
// ==========================================================

model Notificacao {
  id             String          @id @default(cuid())
  organizacaoId  String
  destinatarioId String
  tipo           TipoNotificacao
  titulo         String
  corpo          String?
  linkAcao       String?
  lida           Boolean         @default(false)
  lidaEm         DateTime?
  criadaEm       DateTime        @default(now())

  organizacao  Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  destinatario Usuario     @relation(fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([destinatarioId, lida])
  @@index([organizacaoId])
  @@index([criadaEm])
}

model AuditLog {
  id            String   @id @default(cuid())
  organizacaoId String?
  usuarioId     String?
  acao          String
  ip            String?
  detalhes      Json?
  criadoEm      DateTime @default(now())

  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id])
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([organizacaoId])
  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
}

// ==========================================================
// JORNADA VOCACIONAL — processos eclesiásticos canônicos
// Guard: org.tipoOrganizacao === nova_comunidade
// ==========================================================

model ProcessoEclesiastico {
  id                 String                     @id @default(cuid())
  organizacaoId      String
  formandoId         String
  tipo               TipoProcessoEclesiastico
  nivelFormativo     String
  status             StatusProcessoEclesiastico @default(rascunho)
  dadosFormulario    Json                       @default("{}")
  favoravelRenovacao Boolean?
  numeroRenovacao    Int?
  criadoPorId        String
  criadoEm           DateTime                   @default(now())
  atualizadoEm       DateTime                   @updatedAt

  organizacao Organizacao             @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando    Formando                @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  criadoPor   Usuario                 @relation("ProcessoCriador", fields: [criadoPorId], references: [id])
  documentos  DocumentoEclesiastico[]
  promessa    RegistroPromessa?

  @@index([formandoId])
  @@index([status])
  @@index([organizacaoId, status])
  @@index([organizacaoId, tipo])
}

model DocumentoEclesiastico {
  id                   String                      @id @default(cuid())
  processoId           String
  tipo                 TipoDocumentoEclesiastico
  status               StatusDocumentoEclesiastico @default(pendente)
  versao               Int                         @default(1)
  arquivoId            String?
  substituiDocumentoId String?
  geradoEm             DateTime?
  geradoPorId          String?
  observacoes          String?
  criadoEm             DateTime                    @default(now())

  processo  ProcessoEclesiastico @relation(fields: [processoId], references: [id], onDelete: Cascade)
  arquivo   Arquivo?             @relation(fields: [arquivoId], references: [id])
  geradoPor Usuario?             @relation("DocumentoGerador", fields: [geradoPorId], references: [id])

  @@index([processoId])
  @@index([arquivoId])
}

model RegistroPromessa {
  id                     String               @id @default(cuid())
  organizacaoId          String
  formandoId             String
  processoId             String               @unique
  tipo                   TipoRegistroPromessa
  numeroRegistro         String
  tomo                   String
  folha                  Int
  numero                 Int
  dataVigenciaInicio     DateTime
  dataVigenciaFim        DateTime?
  formulaTexto           String               @db.Text
  celebrante             String
  localCelebracao        String
  moderadorGeral         String
  formadorGeralLocal     String?
  assistenteEclesiastico String?
  secretario             String
  dataDispensa           DateTime?
  autoridadeDispensa     String?
  arquivoTermoId         String?
  criadoPorId            String?
  criadoEm               DateTime             @default(now())

  organizacao  Organizacao          @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando     Formando             @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  processo     ProcessoEclesiastico @relation(fields: [processoId], references: [id], onDelete: Cascade)
  arquivoTermo Arquivo?             @relation(fields: [arquivoTermoId], references: [id])

  // Numeração cartorial sequencial por org+tomo (concorrência-segura via retry P2002).
  @@unique([organizacaoId, tomo, numero])
  @@index([organizacaoId])
  @@index([formandoId])
}

// ==========================================================
// LIVRO DE REGISTRO GERAL DA JORNADA VOCACIONAL
// Livro cartorial append-only/imutável: cada marco da jornada vira um termo.
// ==========================================================

model LivroRegistroTomo {
  id                    String     @id @default(cuid())
  organizacaoId         String
  numero                Int // 1, 2, 3... (exibido em romano)
  totalFolhas           Int        @default(200)
  status                StatusTomo @default(aberto)
  aberturaData          DateTime
  aberturaModerador     String
  aberturaSecretario    String
  aberturaTexto         String     @db.Text
  aberturaArquivoId     String? // PDF assinado/digitalizado
  encerramentoData      DateTime?
  encerramentoTexto     String?    @db.Text
  encerramentoArquivoId String?
  criadoEm              DateTime   @default(now())
  atualizadoEm          DateTime   @updatedAt

  organizacao Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  termos      TermoRegistro[]

  @@unique([organizacaoId, numero])
  @@index([organizacaoId, status])
}

model TermoRegistro {
  id                     String            @id @default(cuid())
  organizacaoId          String
  tomoId                 String
  numero                 Int // sequencial contínuo por tomo (imutável)
  tipo                   TipoTermoRegistro
  formandoId             String?
  dataEvento             DateTime
  dataLavratura          DateTime          @default(now())
  corpoTexto             String            @db.Text // fórmula renderizada — congelada
  condicaoResultante     CondicaoMembro?
  // Referências fracas (sem FK rígida p/ preservar imutabilidade do assento)
  processoId             String?
  registroPromessaId     String?
  arquivoRefId           String?
  retificaTermoId        String? // aponta o termo original (retificação)
  lavradoAutomaticamente Boolean           @default(true)
  criadoPorId            String?
  criadoEm               DateTime          @default(now())

  organizacao Organizacao       @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  tomo        LivroRegistroTomo @relation(fields: [tomoId], references: [id], onDelete: Cascade)
  formando    Formando?         @relation(fields: [formandoId], references: [id], onDelete: SetNull)

  @@unique([tomoId, numero])
  @@index([organizacaoId])
  @@index([formandoId])
  @@index([tomoId])
}

// ==========================================================
// PERÍODO VOCACIONAL
// Turma = GrupoFormacao (tipo=vocacional). A participação é durável e
// sobrevive ao fim da turma — um formando pode passar por várias turmas.
// ==========================================================

model ParticipacaoVocacional {
  id               String                       @id @default(cuid())
  organizacaoId    String
  formandoId       String
  turmaId          String // → GrupoFormacao (tipo=vocacional)
  status           StatusParticipacaoVocacional @default(ativa)
  dataIngresso     DateTime
  dataConclusao    DateTime?
  desfechoCarta    DesfechoCartaVocacional?
  cartaArquivoId   String? // → Arquivo (ref. fraca, sem FK)
  cartaRecebidaEm  DateTime?
  processoGeradoId String? // → ProcessoEclesiastico (ref. fraca)
  acompanhadorId   String?
  // Pré-estado do formando, capturado na inscrição, para reversão não-destrutiva
  // (encerramento por recusa ou cancelamento administrativo).
  grupoOrigemId    String?
  condicaoOrigem   CondicaoMembro?
  // Termo de ingresso lavrado no Livro (ref. fraca) — referenciado na retificação
  // quando a inscrição é cancelada por equívoco.
  termoIngressoId  String?
  criadoEm         DateTime                     @default(now())
  atualizadoEm     DateTime                     @updatedAt

  organizacao     Organizacao                 @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  formando        Formando                    @relation(fields: [formandoId], references: [id], onDelete: Cascade)
  turma           GrupoFormacao               @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  acompanhador    Usuario?                    @relation("AcompanhadorParticipacao", fields: [acompanhadorId], references: [id])
  acompanhamentos AcompanhamentoVocacional[]
  solicitacoes    SolicitacaoAcompanhamento[]

  @@unique([formandoId, turmaId])
  @@index([organizacaoId])
  @@index([turmaId])
  @@index([organizacaoId, status])
}

// Anotações de evolução do acompanhamento individual — FORO ÍNTIMO.
// anotacaoEvolucao é cifrada em repouso (lib/crypto.ts). Visível só ao
// acompanhador + formador responsável pela turma + formador geral/admin.
model AcompanhamentoVocacional {
  id                        String                     @id @default(cuid())
  organizacaoId             String
  participacaoId            String
  acompanhadorId            String
  data                      DateTime
  tipo                      TipoEncontroAcompanhamento @default(mensal)
  solicitadoPeloVocacionado Boolean                    @default(false)
  anotacaoEvolucao          String                     @db.Text
  criadoEm                  DateTime                   @default(now())
  atualizadoEm              DateTime                   @updatedAt

  organizacao  Organizacao            @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  participacao ParticipacaoVocacional @relation(fields: [participacaoId], references: [id], onDelete: Cascade)
  acompanhador Usuario                @relation("AcompanhadorRegistro", fields: [acompanhadorId], references: [id])

  @@index([organizacaoId])
  @@index([participacaoId])
}

// Pedido do vocacionado por um encontro extra de acompanhamento (via Portal).
model SolicitacaoAcompanhamento {
  id             String                          @id @default(cuid())
  participacaoId String
  solicitadoEm   DateTime                        @default(now())
  mensagem       String?
  status         StatusSolicitacaoAcompanhamento @default(pendente)

  participacao ParticipacaoVocacional @relation(fields: [participacaoId], references: [id], onDelete: Cascade)

  @@index([participacaoId])
  @@index([status])
}
