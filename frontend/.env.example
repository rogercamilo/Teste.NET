# ============================================================
# AUTENTICAÇÃO — NextAuth v5
# ============================================================
AUTH_SECRET=gere_com_node_-e_"require('crypto').randomBytes(32).toString('hex')"
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# GOOGLE OAUTH 2.0 (opcional)
# ============================================================
GOOGLE_CLIENT_ID=cole_aqui_o_client_id
GOOGLE_CLIENT_SECRET=cole_aqui_o_client_secret

# ============================================================
# BANCO DE DADOS (PostgreSQL via Docker)
# ============================================================
DATABASE_URL=postgresql://formativo:formativo_dev@localhost:5432/formacao_comunitaria

# ============================================================
# TENANT PADRÃO (single-tenant — Fase 2)
# ============================================================
DEFAULT_ORG_ID=org_default

# ============================================================
# SEED — credenciais do admin inicial
# ============================================================
SEED_ADMIN_EMAIL=admin@suaorganizacao.org
# Se não definido, uma senha aleatória será gerada e exibida uma vez no console
# SEED_ADMIN_PASSWORD=senha_forte_aqui
SEED_ORG_NOME=Nome da Sua Comunidade

# ============================================================
# E-MAIL — Resend (produção) ou SMTP (dev/fallback)
# ============================================================
# Resend tem prioridade quando RESEND_API_KEY estiver definida
RESEND_API_KEY=cole_aqui_resend_api_key
RESEND_FROM=noreply@seudominio.com.br

# SMTP — usado como fallback quando RESEND_API_KEY não estiver definida
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# STRIPE — Billing e assinaturas
# Obter em: https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=cole_aqui_stripe_secret_key
STRIPE_WEBHOOK_SECRET=cole_aqui_stripe_webhook_secret
# IDs dos preços criados no Stripe Dashboard
STRIPE_PRICE_ESSENCIAL=cole_aqui_price_id_essencial
STRIPE_PRICE_PROFISSIONAL=cole_aqui_price_id_profissional

# ============================================================
# SENTRY — Monitoramento de erros (produção)
# Obter em: https://sentry.io/settings/projects/
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=cole_aqui_sentry_dsn
SENTRY_ORG=nome-da-sua-org-no-sentry
SENTRY_PROJECT=plataforma-formativa
# SENTRY_AUTH_TOKEN só necessário para upload de source maps no CI
SENTRY_AUTH_TOKEN=cole_aqui_sentry_auth_token
# Opcional — separa ambientes no painel do Sentry. Se vazio, cai em NODE_ENV
# (development em dev, production no build do Railway). Use p/ rotular "staging" etc.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ============================================================
# CLOUDFLARE R2 — Armazenamento de arquivos (produção)
# ============================================================
R2_ACCOUNT_ID=cole_aqui_account_id
R2_ACCESS_KEY_ID=cole_aqui_access_key_id
R2_SECRET_ACCESS_KEY=cole_aqui_secret_access_key
R2_BUCKET_NAME=plataforma-formativa
R2_PUBLIC_URL=https://seu-bucket.r2.dev
